rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
    }
    match /luckets/{id} {
      allow read: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }
    match /{path=**} {
      allow write: if false;
    }
  }
}
