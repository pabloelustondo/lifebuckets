{
  "name": "lifebuckets",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12 <25"
  },
  "scripts": {
    "dev": "react-router dev --host 127.0.0.1",
    "build": "react-router build && node e2e/build-shell.mjs",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:rules": "node e2e/run.mjs rules",
    "test:e2e": "node e2e/run.mjs browser",
    "test:browser": "playwright test",
    "preview": "node e2e/serve.mjs",
    "local": "node e2e/run.mjs review",
    "build:production": "node scripts/check-production.mjs && react-router build --mode hosted && node e2e/build-shell.mjs",
    "chat:server": "server/.venv/bin/python scripts/chatkit/run.py",
    "test:chat": "server/.venv/bin/python -m pytest server/tests -q"
  },
  "dependencies": {
    "@openai/chatkit-react": "1.6.1",
    "firebase": "12.19.0",
    "isbot": "5.2.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "1.63.0",
    "@react-router/dev": "8.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "firebase-admin": "14.4.0",
    "firebase-tools": "15.30.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
