# Local mode is the default. Do not put production configuration in emulator tests.
VITE_APP_ENV=emulator

# For production, copy to .env.hosted and use the registered Firebase web app's public SDK values.
# These Firebase SDK identifiers are public configuration, not service-account credentials.
# VITE_APP_ENV=production
# VITE_FIREBASE_PROJECT_ID=lifebuckets-bd43d
# VITE_FIREBASE_AUTH_DOMAIN=lifebuckets-bd43d.firebaseapp.com
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_APP_ID=
# VITE_SIGN_IN_METHOD=google
